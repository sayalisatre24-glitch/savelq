# SaveIQ Backend Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Firebase Admin Configuration (From Firebase Console -> Project Settings -> Service Accounts)
FIREBASE_PROJECT_ID=saveiq-ai
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-saveiq@saveiq-ai.iam.gserviceaccount.com
# Paste your private key here (or use single-line formatted key with \n)
FIREBASE_PRIVATE_KEY=""

# Groq AI API Key (Get free key from https://console.groq.com)
GROQ_API_KEY=""
GROQ_MODEL=llama-3.3-70b-versatile

# Email Service / SMTP Configuration (Gmail App Password or any SMTP host)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="SaveIQ AI Goal Tracker <notifications@saveiq.app>"
